ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Which market-data provider the UI uses: "simulated" (default) or "alpaca". Any unset,
# missing, or unrecognized value falls back to simulated — never defaults to real data on
# ambiguity. Needs the VITE_ prefix (unlike the Alpaca keys above) because it's read in
# browser code via import.meta.env, not just the dev-server process.
# "alpaca" only works under `npm run dev` — the Alpaca proxy is dev-only; there's no
# production server-side proxy yet.
VITE_MARKET_DATA_PROVIDER=simulated
