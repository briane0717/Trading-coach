{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["normalized/**/*.ts", "data-providers/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
